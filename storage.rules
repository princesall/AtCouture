rules_version = '2';

// StyleConnect — règles de sécurité Firebase Storage.
//
// Premier usage réel de Storage dans ce projet (voir
// lib/services/order_service.dart:uploadVoiceNote) : mémo vocal enregistré
// par un couturier lors d'un signalement de problème sur une commande (voir
// lib/screens/tailor/report_problem_dialog.dart). Le contrôle d'accès
// s'appuie sur le document orders/{orderId} correspondant dans Firestore —
// mêmes règles d'appartenance que firestore.rules (managesAtelier/tailorId),
// dupliquées ici car Storage ne partage pas ses helpers avec Firestore et ne
// peut lire QUE la base Firestore par défaut, "(default)".

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // L'admin plateforme peut auditer les fichiers (taille des mémos vocaux)
    // depuis la console web — voir PlatformHealthService._measureStorage.
    function isAdmin() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(uid())).data.role == 'admin';
    }

    function orderDoc(orderId) {
      return firestore.get(/databases/(default)/documents/orders/$(orderId)).data;
    }

    function atelierDoc(atelierId) {
      return firestore.get(/databases/(default)/documents/ateliers/$(atelierId)).data;
    }

    function managesAtelier(atelierId) {
      let atelier = atelierDoc(atelierId);
      return isSignedIn() && (atelier.headStylistId == uid() || atelier.companyId == uid());
    }

    function canAccessOrder(orderId) {
      let order = orderDoc(orderId);
      return isSignedIn() && (order.tailorId == uid() || managesAtelier(order.atelierId));
    }

    // ── order_issues/{orderId}/{fileName} — mémo vocal du signalement ────
    match /order_issues/{orderId}/{fileName} {
      allow read: if isAdmin() || canAccessOrder(orderId);
      allow write: if canAccessOrder(orderId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // ── profile_logos/{userId}/logo — logo d'atelier / photo de profil ────
    // Écrit à l'inscription puis modifiable depuis le profil (voir
    // ProfileLogoService). Chaque compte ne peut écrire que SON logo ; la
    // lecture est ouverte à tout utilisateur connecté pour que l'avatar
    // s'affiche aussi chez les membres du même atelier / de la console admin.
    match /profile_logos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Tout le reste est fermé par défaut.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
